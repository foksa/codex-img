{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "codex-img project presets",
  "$defs": {
    "presetObject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "refs": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 5
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "anyOf": [
        {
          "required": [
            "text"
          ]
        },
        {
          "required": [
            "refs"
          ]
        }
      ]
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "events": {
      "type": "boolean",
      "default": true,
      "description": "Write run history to .codex-img/runs/ and list the project in projects.json (default true). In the global presets.json, the setting for runs outside a project and for projects that don't say. CODEX_IMG_EVENTS overrides it. Manifests are written either way."
    },
    "views": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-]{1,64}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "refs": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "maxItems": 0
                  }
                ]
              }
            },
            "anyOf": [
              {
                "required": [
                  "text"
                ]
              },
              {
                "required": [
                  "refs"
                ]
              }
            ]
          }
        ]
      }
    },
    "styles": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-]{1,64}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "refs": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 5
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "anyOf": [
              {
                "required": [
                  "text"
                ]
              },
              {
                "required": [
                  "refs"
                ]
              }
            ]
          }
        ]
      }
    },
    "characters": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-]{1,64}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "refs": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 5
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "anyOf": [
              {
                "required": [
                  "text"
                ]
              },
              {
                "required": [
                  "refs"
                ]
              }
            ]
          }
        ]
      }
    },
    "palettes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-]{1,64}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 255
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "refs": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "maxItems": 0
                  }
                ]
              }
            },
            "anyOf": [
              {
                "required": [
                  "text"
                ]
              },
              {
                "required": [
                  "refs"
                ]
              }
            ]
          }
        ]
      }
    }
  }
}
